# ==========================================
# GoERP Environment Configuration
# ==========================================

# Server Port & Environment
PORT=8080
ENVIRONMENT=development

# Database Engine: 'sqlite' or 'postgres'
DB_TYPE=sqlite

# SQLite Configuration (when DB_TYPE=sqlite)
DB_PATH=erp.db

# PostgreSQL / Google Cloud SQL Configuration (when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=erp
DB_PASSWORD=erp_secret_password
DB_NAME=erp_db
DB_SSLMODE=disable

# Security & Authentication
JWT_SECRET=super-secure-jwt-key-2026-production
UPLOAD_DIR=./uploads/attachments

# ==========================================
# Multi-Provider AI Router & Popular AI Agent APIs
# ==========================================
# Options: "auto", "gemini", "vertex_ai", "openai", "anthropic", "deepseek", "cloudflare", "local"
AI_PROVIDER=auto

# 1. Google Gemini API & Google Cloud Vertex AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GCP_PROJECT_ID=
GCP_LOCATION=asia-southeast2
GCP_VERTEX_MODEL=gemini-2.5-pro

# 2. OpenAI API / Agents SDK (GPT-4o / o3-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# 3. Anthropic Claude API & Model Context Protocol (MCP)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest

# 4. DeepSeek / OpenRouter Reasoning Agent API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 5. Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# ==========================================
# Cloud Object Storage & Data Analytics
# ==========================================

# Google Cloud Platform (GCS, BigQuery, Pub/Sub)
GCS_BUCKET=
GCS_ACCESS_KEY_ID=
GCS_SECRET_ACCESS_KEY=
GCS_ENDPOINT=https://storage.googleapis.com
GCP_BIGQUERY_DATASET=goerp_analytics
GCP_PUBSUB_TOPIC=goerp-domain-events

# Cloudflare R2 Object Storage
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
