# ==========================================
# Odoo-Go ERP Environment Configuration
# ==========================================

# Server Port
PORT=8080

# Database Engine: 'sqlite' or 'postgres'
DB_TYPE=sqlite

# SQLite Configuration (when DB_TYPE=sqlite)
DB_PATH=odoo_erp.db

# PostgreSQL Configuration (when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=odoo_secret_password
DB_NAME=odoo_erp

# Security & Authentication
JWT_SECRET=super-secure-jwt-key-2026-production
