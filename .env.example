# ==========================================
# GoERP Environment Configuration
# ==========================================

# Server Port
PORT=8080

# Database Engine: 'sqlite' or 'postgres'
DB_TYPE=sqlite

# SQLite Configuration (when DB_TYPE=sqlite)
DB_PATH=erp.db

# PostgreSQL Configuration (when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=erp
DB_PASSWORD=erp_secret_password
DB_NAME=erp_db

# Security & Authentication
JWT_SECRET=super-secure-jwt-key-2026-production
